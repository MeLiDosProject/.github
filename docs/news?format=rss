98/d5f8ad1f-7b5d-423f-8695-ae557d19cbd7/Influence+of+the+Human+Field+of+View+on+Visual+and+Non-Visual+Quantities+in+Indoor+Environments.png?format=1500w 1500w, https://images.squarespace-cdn.com/content/v1/648634294b225a176c0f3398/d5f8ad1f-7b5d-423f-8695-ae557d19cbd7/Influence+of+the+Human+Field+of+View+on+Visual+and+Non-Visual+Quantities+in+Indoor+Environments.png?format=2500w 2500w" loading="lazy" decoding="async" data-loader="sqs">

            
          
        
          
        

        
          
